{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vlm-benchmark.dev/schemas/run-results.json",
  "title": "RunResults",
  "type": "object",
  "required": ["run_id", "by_model"],
  "properties": {
    "run_id": { "type": "string" },
    "by_model": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "primary_score": { "type": "number" },
          "correct": { "type": "integer" },
          "total": { "type": "integer" },
          "latency_ms": {
            "type": "object",
            "properties": {
              "p50": { "type": "number" },
              "p95": { "type": "number" },
              "mean": { "type": "number" }
            }
          },
          "cost_usd": { "type": "number" },
          "errors": { "type": "integer" }
        }
      }
    }
  }
}

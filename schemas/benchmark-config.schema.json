{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm-benchmark.dev/schemas/benchmark-config.schema.json",
  "title": "BenchmarkConfig",
  "type": "object",
  "required": ["name", "prompts", "dataset", "models", "metric"],
  "properties": {
    "name": { "type": "string" },
    "prompts": {
      "type": "object",
      "properties": {
        "system": { "type": "string" },
        "user": { "type": "string" }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["manifest"],
      "properties": {
        "manifest": { "type": "string" },
        "base_dir": { "type": "string" }
      }
    },
    "models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metric": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" }
      }
    }
  }
}
